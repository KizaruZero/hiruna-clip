{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KizaruZero/hiruna-clip/blob/main/docs/schemas/audio-events.schema.json",
  "title": "Hiruna Clip Audio Events",
  "type": "object",
  "required": ["schema_version", "source", "events"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "duration": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}$" },
        "analysis_window_ms": { "type": "integer", "minimum": 100 }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["timestamp", "type", "strength"],
        "properties": {
          "timestamp": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,3})?$" },
          "type": {
            "type": "string",
            "enum": ["energy_spike", "volume_peak", "silence_break", "high_energy", "low_energy"]
          },
          "strength": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}