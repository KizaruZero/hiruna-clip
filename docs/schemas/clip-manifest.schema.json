{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KizaruZero/hiruna-clip/blob/main/docs/schemas/clip-manifest.schema.json",
  "title": "Hiruna Clip Manifest",
  "type": "object",
  "required": ["schema_version", "source", "clips"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": {
      "type": "object",
      "required": ["url", "title", "duration"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "title": { "type": "string" },
        "duration": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}$" }
      },
      "additionalProperties": false
    },
    "clips": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "duration", "title", "score", "confidence", "signals", "reason", "story"],
        "properties": {
          "id": { "type": "string" },
          "start": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,3})?$" },
          "end": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,3})?$" },
          "duration": { "type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}(?:\\.\\d{1,3})?$" },
          "title": { "type": "string" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "signals": {
            "type": "object",
            "required": ["hook", "surprise", "emotion", "humor", "tension", "rarity", "value", "reaction", "audio_energy", "self_contained"],
            "properties": {
              "hook": { "type": "number", "minimum": 0, "maximum": 100 },
              "surprise": { "type": "number", "minimum": 0, "maximum": 100 },
              "emotion": { "type": "number", "minimum": 0, "maximum": 100 },
              "humor": { "type": "number", "minimum": 0, "maximum": 100 },
              "tension": { "type": "number", "minimum": 0, "maximum": 100 },
              "rarity": { "type": "number", "minimum": 0, "maximum": 100 },
              "value": { "type": "number", "minimum": 0, "maximum": 100 },
              "reaction": { "type": "number", "minimum": 0, "maximum": 100 },
              "audio_energy": { "type": "number", "minimum": 0, "maximum": 100 },
              "self_contained": { "type": "number", "minimum": 0, "maximum": 100 }
            },
            "additionalProperties": false
          },
          "reason": { "type": "string" },
          "story": {
            "type": "object",
            "required": ["setup", "event", "payoff"],
            "properties": {
              "setup": { "type": "string" },
              "event": { "type": "string" },
              "payoff": { "type": "string" }
            },
            "additionalProperties": false
          },
          "audio_events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["timestamp", "type", "strength"],
              "properties": {
                "timestamp": { "type": "string" },
                "type": { "type": "string" },
                "strength": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}